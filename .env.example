CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_APP_ID=your_circle_app_id_here
CIRCLE_ENTITY_SECRET=your_32_byte_hex_entity_secret_here
MARKET_CONTRACT=0xca048d69BaA38C6364d3E107c2b389BB8D1320dB
FACTORY_ADDRESS=your_deployed_factory_address_here
PRIVATE_KEY=your_admin_wallet_private_key_here
WALLET_SET_ID=your_wallet_set_id_after_first_run
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
PORT=3000

# ── Security (new) ────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Leave empty to allow all (dev only).
ALLOWED_ORIGINS=https://pulsmarket.tech
# Comma-separated userIds allowed to call admin endpoints like /api/market/resolve
# (e.g. supabase_<your-uuid>)
ADMIN_USER_IDS=
# Optional rate limit tuning (requests per minute per IP)
RATE_LIMIT_GENERAL=300
RATE_LIMIT_STRICT=30
# Requests/min/IP for trading endpoints (buy/sell/save-external/limit-order). Generous by design.
RATE_LIMIT_TRADE=600
RATE_LIMIT_ACTIVATE=10

# ── Gasless wallets (Circle Gas Station) ──────────────────────────────────────
# SCA = ERC-4337 smart contract account → eligible for Circle Gas Station so new
#       users transact gaslessly (Arc Testnet has a preconfigured policy).
# EOA = legacy externally-owned account (needs USDC for gas). Default: SCA.
WALLET_ACCOUNT_TYPE=SCA

# ── Webhook security ──────────────────────────────────────────────────────────
# Circle signs webhooks with ECDSA. Verification is always attempted; set to true
# to REJECT requests that fail/lack a valid signature (recommended once confirmed).
CIRCLE_WEBHOOK_ENFORCE=false
# Shared secret for the QuickNode webhook (sent as x-qn-secret header or ?secret=).
QUICKNODE_WEBHOOK_SECRET=

# ── Treasury monitoring / alerts ──────────────────────────────────────────────
# Alert when the admin/treasury wallet drops below this many USDC.
TREASURY_MIN_USDC=10
# Optional Slack-compatible incoming webhook URL for low-treasury / funding alerts.
ALERT_WEBHOOK_URL=

# ── Stale-market hygiene ──────────────────────────────────────────────────────
# Auto-archive markets this many days past deadline that Polymarket can't resolve.
ARCHIVE_AFTER_DAYS=3

# ── Agent LLM (primary + fallbacks) ───────────────────────────────────────────
# OpenAI-compatible chat-completions providers, tried in priority order:
# primary = AGENT_LLM_URL/KEY/MODEL, then _2, _3, … as fallbacks. A provider is
# skipped unless URL, KEY and MODEL are all set. URL may be a base ("…/v1") —
# "/chat/completions" is appended automatically. Keys live only here, never in git.
AGENT_LLM_URL=https://token-plan-sgp.xiaomimimo.com/v1
AGENT_LLM_KEY=your_primary_llm_key_here
AGENT_MODEL=mimo-v2.5-pro
# Fallback #2 (e.g. IO Intelligence / Kimi K2)
AGENT_LLM_URL_2=https://api.intelligence.io.solutions/api/v1
AGENT_LLM_KEY_2=your_fallback_llm_key_here
AGENT_MODEL_2=moonshotai/Kimi-K2-Thinking
# Per-attempt timeout (ms) and attempts per provider before moving to the next.
AGENT_LLM_TIMEOUT_MS=60000
AGENT_LLM_RETRIES=1

# ── Blockscout (Economy Explorer / on-chain proofs) ───────────────────────────
# API key: https://api.blockscout.com/{chainId}/api/v2/...?apikey=...  (Arc = 5042002)
BLOCKSCOUT_API_KEY=your_blockscout_api_key_here

# ── x402 creator-monetization layer (Circle Gateway nanopayments on Arc) ──
# Seller wallet that receives per-read USDC nanopayments. Generate a dedicated
# EOA for this (never reuse the admin/treasury key). Address is public; the
# private key only matters if/when the seller withdraws Gateway earnings.
X402_SELLER_ADDRESS=0xYourSellerWalletAddress
# Optional: route Arc RPC through your Canteen-hosted endpoint so hackathon
# organizers see activity (export from `arc-canteen` → ~/.arc-canteen/env).
# ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/...
