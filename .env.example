CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_APP_ID=your_circle_app_id_here
CIRCLE_ENTITY_SECRET=your_32_byte_hex_entity_secret_here
MARKET_CONTRACT=0xca048d69BaA38C6364d3E107c2b389BB8D1320dB
FACTORY_ADDRESS=your_deployed_factory_address_here
PRIVATE_KEY=your_admin_wallet_private_key_here
WALLET_SET_ID=your_wallet_set_id_after_first_run
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
PORT=3000

# ── Security (new) ────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Leave empty to allow all (dev only).
ALLOWED_ORIGINS=https://pulsmarket.tech
# Comma-separated userIds allowed to call admin endpoints like /api/market/resolve
# (e.g. supabase_<your-uuid>)
ADMIN_USER_IDS=
# Optional rate limit tuning (requests per minute per IP)
RATE_LIMIT_GENERAL=300
RATE_LIMIT_STRICT=30
# Requests/min/IP for trading endpoints (buy/sell/save-external/limit-order). Generous by design.
RATE_LIMIT_TRADE=600
RATE_LIMIT_ACTIVATE=10

# ── Gasless wallets (Circle Gas Station) ──────────────────────────────────────
# SCA = ERC-4337 smart contract account → eligible for Circle Gas Station so new
#       users transact gaslessly (Arc Testnet has a preconfigured policy).
# EOA = legacy externally-owned account (needs USDC for gas). Default: SCA.
WALLET_ACCOUNT_TYPE=SCA

# ── Webhook security ──────────────────────────────────────────────────────────
# Circle signs webhooks with ECDSA. Verification is always attempted; set to true
# to REJECT requests that fail/lack a valid signature (recommended once confirmed).
CIRCLE_WEBHOOK_ENFORCE=false
# Shared secret for the QuickNode webhook (sent as x-qn-secret header or ?secret=).
QUICKNODE_WEBHOOK_SECRET=

# ── Treasury monitoring / alerts ──────────────────────────────────────────────
# Alert when the admin/treasury wallet drops below this many USDC.
TREASURY_MIN_USDC=10
# Optional Slack-compatible incoming webhook URL for low-treasury / funding alerts.
ALERT_WEBHOOK_URL=

# ── Stale-market hygiene ──────────────────────────────────────────────────────
# Auto-archive markets this many days past deadline that Polymarket can't resolve.
ARCHIVE_AFTER_DAYS=3

# ── Agent LLM (primary + fallbacks) ───────────────────────────────────────────
# Chat providers tried in priority order: primary = AGENT_LLM_URL/KEY/MODEL,
# then _2 … _10 as fallbacks. A provider is skipped unless URL, KEY and MODEL are
# all set. For OpenAI-compatible APIs the URL may be a base ("…/v1") —
# "/chat/completions" is appended automatically. Keys live only here, never in git.
#
# Google Gemini is supported too: set AGENT_LLM_FORMAT_n=gemini (auto-detected for
# generativelanguage.googleapis.com hosts). For Gemini, URL is the base
# ("https://generativelanguage.googleapis.com/v1beta") and KEY is the API key;
# "/models/<MODEL>:generateContent" is appended automatically.
#
# Put the fastest, most reliable providers first (e.g. Groq, Cerebras) so the
# agent loop stays snappy and only falls through on outage/rate-limit.
AGENT_LLM_URL=https://api.groq.com/openai/v1
AGENT_LLM_KEY=your_groq_key_here
AGENT_MODEL=openai/gpt-oss-120b
# Fallback #2 — Cerebras (very fast)
AGENT_LLM_URL_2=https://api.cerebras.ai/v1
AGENT_LLM_KEY_2=your_cerebras_key_here
AGENT_MODEL_2=gpt-oss-120b
# Fallback #3 — Mistral
AGENT_LLM_URL_3=https://api.mistral.ai/v1
AGENT_LLM_KEY_3=your_mistral_key_here
AGENT_MODEL_3=mistral-small-latest
# Fallback #4 — LiteRouter (free)
AGENT_LLM_URL_4=https://api.literouter.com/v1
AGENT_LLM_KEY_4=your_literouter_key_here
AGENT_MODEL_4=deepseek-v3.2:free
# Fallback #5 — Google Gemini (different wire format)
AGENT_LLM_URL_5=https://generativelanguage.googleapis.com/v1beta
AGENT_LLM_KEY_5=your_gemini_key_here
AGENT_MODEL_5=gemini-2.5-flash
AGENT_LLM_FORMAT_5=gemini
# Fallbacks #6–#10 available (LLM7, ZenMux, OpenCode Zen, OpenRouter, TokenRouter …)
# AGENT_LLM_URL_6=… AGENT_LLM_KEY_6=… AGENT_MODEL_6=…
# Per-attempt timeout (ms) and attempts per provider before moving to the next.
AGENT_LLM_TIMEOUT_MS=60000
AGENT_LLM_RETRIES=1

# ── Agent web research (keyless Jina + DuckDuckGo) ───────────────────────────
# How many of the top search hits are fully read+parsed (not just snippet).
AGENT_RESEARCH_DEEP=6
# Per-fetch timeout for Jina Reader (search + each page read).
AGENT_RESEARCH_TIMEOUT_MS=20000
# Disable research entirely (every signal ships without sources) — for offline/dev.
# AGENT_RESEARCH_ENABLED=false

# ── Signal quality gate ───────────────────────────────────────────────────────
# A signal is only published if it has at least this many researched sources AND
# the LLM thesis is at least this many chars. Below the bar → skip this cycle.
AGENT_SIGNAL_SOURCES_MIN=6
AGENT_SIGNAL_THESIS_MIN=1500

# ── Agent Duel (Colosseum) ────────────────────────────────────────────────────
# Two agents stake USDC on opposite sides of the same market. The loser's stake
# goes to the winner on market resolution. Requires AgentDuel.sol on Arc.
AGENT_DUEL_ENABLED=true
AGENT_DUEL_ADDRESS=0xYourDeployedAgentDuelAddress
AGENT_DUEL_STAKE_USDC=0.1
AGENT_DUEL_INTERVAL_MIN=6

# ── Blockscout (Economy Explorer / on-chain proofs) ───────────────────────────
# API key: https://api.blockscout.com/{chainId}/api/v2/...?apikey=...  (Arc = 5042002)
BLOCKSCOUT_API_KEY=your_blockscout_api_key_here

# ── x402 creator-monetization layer (Circle Gateway nanopayments on Arc) ──
# Seller wallet that receives per-read USDC nanopayments. Generate a dedicated
# EOA for this (never reuse the admin/treasury key). Address is public; the
# private key only matters if/when the seller withdraws Gateway earnings.
X402_SELLER_ADDRESS=0xYourSellerWalletAddress
# Optional: route Arc RPC through your Canteen-hosted endpoint so hackathon
# organizers see activity (export from `arc-canteen` → ~/.arc-canteen/env).
# ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/...

# ── Copy-trade creator layer (T1) ─────────────────────────────────────────────
# When a leader (followed forecaster) opens a BUY, the backend mirrors it onto
# each active follower's wallet (scaled to their per-trade cap) and pays the
# leader a per-event creator micro-fee. LIVE EXECUTION IS OFF BY DEFAULT so the
# feature can ship without auto-spending follower funds. Set to "true" only for
# a deliberate demo run, after followers have been funded.
COPY_TRADE_ENABLED=false
# Per-event creator fee the follower pays the leader on each copied trade (USDC).
COPY_FEE_USDC=0.005
# Alpha paid-analysis: when true, unlocking a premium forecast pays the creator a
# real on-chain USDC micro-fee from the reader's wallet. Default OFF (no funds move).
ALPHA_PAID_ENABLED=false

# Creator Signals (full creator-economy content layer).
# SIGNALS_ENABLED: master switch for the signals routes (default ON; moves no
#   funds in draft/publish — only unlock does).
SIGNALS_ENABLED=true
# SIGNALS_PAID_ENABLED: when true, unlocking a signal pays the creator a real
#   on-chain USDC micro-fee from the reader's wallet. Default OFF.
SIGNALS_PAID_ENABLED=false
# Deployed SignalRegistry contract address on Arc (from deploySignalRegistry.mjs).
# When set + admin wallet present, publishing writes an on-chain attestation.
SIGNAL_REGISTRY_ADDRESS=
